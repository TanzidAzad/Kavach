{
  "manifest_version": 3,
  "name": "Kavach",
  "version": "0.2.0",
  "description": "Catches scam messages in any language and explains them in yours.",
  "icons": {
    "16": "sidepanel/brand/icon16.png",
    "32": "sidepanel/brand/icon32.png",
    "48": "sidepanel/brand/icon48.png",
    "128": "sidepanel/brand/icon128.png"
  },
  "action": {
    "default_title": "Kavach",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "sidepanel/brand/icon16.png",
      "32": "sidepanel/brand/icon32.png",
      "48": "sidepanel/brand/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "sidePanel",
    "scripting",
    "activeTab",
    "notifications"
  ],
  "host_permissions": [
    "http://localhost:8787/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://example.com/*"
      ],
      "js": [
        "sidepanel/test/card-test.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "sidepanel/brand/mark-dark.png",
        "sidepanel/brand/mark-cream.png",
        "sidepanel/brand/logo-header.png"
      ],
      "matches": [
        "https://mail.google.com/*",
        "https://outlook.live.com/*",
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*",
        "https://web.whatsapp.com/*",
        "https://example.com/*"
      ]
    }
  ]
}
