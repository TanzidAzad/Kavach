# Copy to server/.env and fill in. Never commit .env.
NVIDIA_API_KEY=your-nvidia-api-key-here
PORT=8787
# hosted = build.nvidia.com (needs key) · brev = self-hosted NIMs via `brev port-forward`
NIM_BACKEND=hosted
BREV_LLM_URL=http://localhost:8000
BREV_VL_URL=http://localhost:8001
# Optional: override model IDs served by the Brev NIMs (check with scripts/smoke.js brev)
# BREV_LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# BREV_VL_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
